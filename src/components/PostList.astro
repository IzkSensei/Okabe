---
import { displayDate, postUrl, type Post } from '../lib/posts';
import '../styles/blog.css';
interface Props { posts: Post[] }
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map(post => (
    <li class="post-row" data-language={post.data.lang} data-tags={JSON.stringify(post.data.tags)}>
      <time datetime={post.data.date.toISOString().slice(0, 10)}>{displayDate(post.data.date, 'en', false)}</time>
      <a class="post-title" href={postUrl(post)} lang={post.data.lang} dir={post.data.lang === 'fa' ? 'rtl' : 'ltr'}>{post.data.title}</a>
      <span class="post-language" lang={post.data.lang}>{post.data.lang === 'fa' ? 'فارسی' : 'English'}</span>
    </li>
  ))}
</ul>
